# Copy to .env.local and fill in dev values. See README: Accounts.
# Prod values live only in Vercel's Production environment: never put them here or in .env.local.

# Neon Postgres: the `dev` branch of the Word Duel Neon project, never prod.
# Neon console → Branches → dev → Connect: the pooled string, then the direct one.
# (vercel env pull fills these with prod's: replace them, and delete the PG* and POSTGRES_* lines it adds.)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth: from vercel env pull (Development), or make one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps; a provider without both values is left out. From vercel env pull (Development):
# GitHub is the dev app; Google and Discord share one app with prod.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Ably, for versus: a key with Publish, Subscribe and Presence on versus:* channels. Server only.
# From vercel env pull (Development); the key is shared with prod, so dev rooms use versus:dev-<code> channels.
ABLY_API_KEY=
