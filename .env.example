# Copy to .env.local. See README: Accounts.

# Neon Postgres (vercel env pull .env.local fills these in)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps; a provider without both values is left out
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
