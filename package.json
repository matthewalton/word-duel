{
  "name": "word-duel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:packs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-packs.mts",
    "packs:ids": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/add-pack-ids.mts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.mts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-migrate.mts",
    "db:migrate:prod": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-migrate-prod.mts",
    "db:reset:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-reset-dev.mts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.0.5"
}
